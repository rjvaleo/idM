# dependencies
node_modules

# build output
dist/
dist-pages/
dist-single/
*.local

# rust build output (24 MB after one debug + release + wasm build)
rust/target/

# engine artifacts, regenerated by: npm run build:engine
public/idmlab-engine.wasm
public/idmlab-rack.js

# release packaging (produced by .github/workflows/release.yml)
release/
release-notes.md

# sample libraries — source material, kept locally rather than in the repo.
# 1.2 GB between them, against a 92 MB .git, and none of it is needed to build
# or test. Committing either would roughly fourteen-times the clone.
Audio - Archival LIBRARY/
Audio - dec 2004 sound design/

# test coverage
coverage/

# vite temp / cache
*.timestamp-*.mjs
.vite-temp/
.vite/

# generated standalone preview (regenerate with: npm run build:single)
M-Clone-preview.html

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# dev launcher runtime state
.mclone-dev.log
.mclone-dev.pid

# personal editor/agent settings (launch.json is shared)
.claude/settings.local.json

# library build output (regenerated by: npm run build:lib, and by npm on install)
lib/

# single-file build output (regenerate with: npm run build:single)
dist-single/
