{
  "name": "m-clone",
  "private": true,
  "version": "0.8.0-alpha",
  "type": "module",
  "description": "A modern browser-first recreation of M, the interactive composing instrument.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "cargo build -p idmlab-engine --manifest-path rust/Cargo.toml --target wasm32-unknown-unknown --release && mkdir -p public && cp rust/target/wasm32-unknown-unknown/release/idmlab_engine.wasm public/idmlab-engine.wasm",
    "build:worklet": "node scripts/build-worklet.mjs",
    "build:engine": "npm run build:wasm && npm run build:worklet",
    "verify:wasm": "npm run build:wasm && node rust/wasm/verify.mjs",
    "build:pages": "tsc --noEmit && vite build --config vite.config.pages.ts",
    "build:single": "vite build --config vite.config.single.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "spec:audit": "node scripts/spec-audit.mjs",
    "spec:strict": "node scripts/spec-audit.mjs --strict"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
