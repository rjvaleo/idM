{
  "name": "idm",
  "private": true,
  "version": "0.8.0-alpha",
  "type": "module",
  "description": "idM — an algorithmic composer inspired by M, the classic sequencer. Runs in a browser, as a standalone app, and as an AU / VST3 / CLAP plugin that generates MIDI.",
  "license": "AGPL-3.0-or-later",
  "author": "rjvaleo",
  "homepage": "https://github.com/rjvaleo/idM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjvaleo/idM.git"
  },
  "bugs": {
    "url": "https://github.com/rjvaleo/idM/issues"
  },
  "keywords": [
    "midi",
    "algorithmic-composition",
    "generative-music",
    "sequencer",
    "vst3",
    "audio-unit",
    "clap",
    "juce"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --config vite.config.single.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "goldens": "vite-node scripts/goldens.ts",
    "goldens:check": "vite-node scripts/goldens.ts --check",
    "build:lib": "tsc -p tsconfig.lib.json && cp src/styles.css lib/styles.css",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./styles.css": "./lib/styles.css"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
